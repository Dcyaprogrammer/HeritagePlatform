### Local overrides (DO NOT COMMIT secrets)
#
# Copy this file to `application-local.properties` and fill in your local values.
# This repo's `.gitignore` ignores `application-local.properties`.

# MySQL Database Configuration (example)
spring.datasource.url=jdbc:mysql://localhost:3306/heritage_platform?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=CHANGE_ME

